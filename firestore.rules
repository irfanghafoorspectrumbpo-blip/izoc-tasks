rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function myRole()    { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isSenior()  { return signedIn() && myRole() == 'senior'; }
    function isSup()     { return signedIn() && myRole() == 'supervisor'; }
    function isStaff()   { return isSenior() || isSup(); }
    function isActive()  { return signedIn() && myRole() in ['senior', 'supervisor', 'member']; }
    function myEmail()   { return request.auth.token.email.lower(); }
    function invitePath() { return /databases/$(database)/documents/invites/$(myEmail()); }
    function matchesInvite() {
      return exists(invitePath())
        && request.auth.token.email_verified == true
        && request.resource.data.email.lower() == myEmail()
        && request.resource.data.role == get(invitePath()).data.role
        && request.resource.data.designation == get(invitePath()).data.designation
        && request.resource.data.supervisorId == get(invitePath()).data.supervisorId;
    }
    function cleanPending() {
      return request.resource.data.role == 'pending'
        && request.resource.data.designation == ''
        && request.resource.data.supervisorId == ''
        && request.resource.data.email.lower() == myEmail();
    }

    match /users/{uid} {
      allow read: if isActive() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && (cleanPending() || matchesInvite())
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'supervisorId', 'phone', 'employeeId', 'designation', 'doj', 'photo', 'createdAt']);
      allow update: if isSenior()
        || (isActive() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'photo']));
      allow delete: if isSenior();
    }

    match /invites/{em} {
      allow read: if isSenior() || (signedIn() && myEmail() == em);
      allow create, update: if isSenior();
      allow delete: if isSenior() || (signedIn() && myEmail() == em);
    }

    match /projects/{pid} {
      allow read: if isActive();
      allow create, update: if isStaff();
      allow delete: if isSenior();
    }

    match /projectDetails/{pid} {
      allow read, create, update: if isStaff();
      allow delete: if isSenior();
    }

    match /tasks/{tid} {
      function mgr(d) { return d.supervisorId == request.auth.uid || request.auth.uid in d.get('managerIds', []); }
      function myOfficer(aid) {
        return aid == request.auth.uid
          || get(/databases/$(database)/documents/users/$(aid)).data.supervisorId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(aid)).data.get('coSupervisorId', '') == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/users/$(aid)).data.get('managerIds', []);
      }
      allow read: if isSenior()
        || (isSup() && mgr(resource.data))
        || (isActive() && (resource.data.assigneeId == request.auth.uid
            || request.auth.uid in resource.data.get('assigneeIds', [])));

      allow create: if isStaff()
        && request.resource.data.assignedById == request.auth.uid
        && request.resource.data.status == 'Not Started'
        && (isSenior() || (mgr(request.resource.data) && myOfficer(request.resource.data.assigneeId)));

      allow update: if isSenior()
        || (isSup() && mgr(resource.data) && mgr(request.resource.data)
            && myOfficer(request.resource.data.assigneeId))
        || (isActive() && (resource.data.assigneeId == request.auth.uid
                || request.auth.uid in resource.data.get('assigneeIds', []))
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'notes', 'startedAt', 'completedAt', 'workMs',
                           'lastResumeAt', 'history', 'updatedAt']));

      allow delete: if isSenior() || (isSup() && mgr(resource.data));
    }
  }
}
